# ------------------------------------------------------------------------------
# Twenty CRM environment — copy to `.env` and fill in real values.
#   cp .env.example .env
#   ./scripts/gen-secrets.sh        # fills the SECRETS below for you
# NEVER commit the real .env. Secrets live here, not in docker-compose.yml.
# ------------------------------------------------------------------------------

# Pinned, known-good release. Do NOT use `latest`. Bump deliberately (see README "Upgrade").
TAG=v2.8.3

# Public URL Twenty is served on (through Caddy). Must be https and match the Caddy site.
SERVER_URL=https://crm.utomat.com

# Open signup is ON for first boot so you can create the admin user.
# Flip to false and re-run `docker compose up -d` right after (see README step 6).
IS_SIGNUP_ENABLED=true

# --- Postgres (internal only; never published to the host/internet) ---
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=__REDACTED__GENERATE_ME__   # strong, NO special characters
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

# --- Redis (internal only) ---
REDIS_URL=redis://redis:6379

# --- Storage ---
STORAGE_TYPE=local

# --- SECRETS (generate with: openssl rand -base64 32) ---
# ENCRYPTION_KEY is critical: losing it = losing every secret stored in the DB. Back it up.
ENCRYPTION_KEY=__REDACTED__GENERATE_ME__
# Only set FALLBACK_ENCRYPTION_KEY to the OLD key during a key rotation; leave empty otherwise.
FALLBACK_ENCRYPTION_KEY=
# APP_SECRET is legacy (pre-ENCRYPTION_KEY). Generated for completeness/compat.
APP_SECRET=__REDACTED__GENERATE_ME__

# --- AI features (optional) ---
# Paste your Anthropic key here on the box (do not commit it). Leave blank to run without AI.
ANTHROPIC_API_KEY=

# Leave these blank on the server (worker overrides them itself).
DISABLE_DB_MIGRATIONS=
DISABLE_CRON_JOBS_REGISTRATION=
